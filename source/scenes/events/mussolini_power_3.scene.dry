@contact_ds
choose-if: ds_leader != "Carnazza" and ((ds_relation >= 55 and ds_leader == "Giuffrida") or (ds_relation >= 70 and ds_leader == "Colonna"))
unavailable-subtitle: [? if ds_leader != "Carnazza" : Our relations with the <span style="font-weight: bold; color:#1E99C5;">[+ ds_name +]</span> are too poor for this. ?][? if ds_leader == "Carnazza" : The <span style="font-weight: bold; color:#1E99C5;">[+ ds_name +]</span> would never form a joint list with us. ?]
on-arrival: anti_fas_ds = 1
go-to: list_menu
max-visits: 1


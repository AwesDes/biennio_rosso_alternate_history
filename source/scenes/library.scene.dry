Industrialists & Landowners: <span style="font-weight: bold; color:#ED2855">[+ psi_name +]</span>: [+ industrialists_psi_display +]%, [? if pcdi_formed : <span style="font-weight: bold; color:#C72F35">PCd'I</span>: [+ industrialists_pcdi_display +]%, ?] [? if psu_formed : <span style="font-weight: bold; color:#E35A5A">PSU</span>: [+ industrialists_psu_display +]%, ?] <span style="font-weight: bold; color:#FFC0CB;">PSRI</span>: [+ industrialists_psri_display +]%, [? if pll_formed : <span style="font-weight: bold; color:#FFD1D9;">PLL</span>: [+ industrialists_pll_display +]%, ?] [? if pri_prominent = 1 : <span style="font-weight: bold; color:#3CB371">PRI</span>: [+ industrialists_pri_display +]%, ?] <span style="font-weight: bold; color:#1E99C5;">[+ ds_name +]</span>: [+ industrialists_ds_display +]%, <span style="font-weight: bold; color:#87CEFA;">PPI</span>: [+ industrialists_ppi_display +]%, <span style="font-weight: bold; color:#FFD700;">[+ ldr_name +]</span>: [+ industrialists_ldr_display +]%, <span style="font-weight: bold; color:#0047AB;">[+ ul_name +]</span>: [+ industrialists_ul_display +]%, [? if pcs_formed = 1 : <span style="font-weight: bold; color:#656573;">PCS</span>: [+ industrialists_pcs_display +]%, ?] [? if not pnf_banned : <span style="font-weight: bold; color:#3D3D3D;">[+ pnf_name +]</span>: [+ industrialists_pnf_display +]%, ?] Others: [+ industrialists_other_display +]%


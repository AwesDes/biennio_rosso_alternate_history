title: <span style="color:#3D3D3D;">Arditismo</span> unbanned
subtitle: The judges have re-legalized the <span style="color:#3D3D3D;">Arditismo</span>.
new-page: true
view-if: ard_banned == 1 and ard_ban_timer == 0 and (judicial_reform < 2 or pnf_in_government) and not national_congress_seen and not pnf_banned and not march_failed

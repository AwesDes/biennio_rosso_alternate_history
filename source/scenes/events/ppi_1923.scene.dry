Q.ppi_left -= 2;
Q.ppi_moderates -= 2;

if (Q.socialist_catholic_coalition == 1) {
    Q.ppi_left += 1;
}
if (Q.ppi_relation >= 40) {
    Q.ppi_left += 1;
}
if (Q.pope === "Gasparri") {
    Q.ppi_left += 1;
}
if (Q.roman_question_answered == 1) {
    Q.ppi_left += 2;
}
if (Q.ppi_relation < 40) {
    Q.ppi_moderates += 1;
}
if (Q.not_participating == 1) {
    Q.ppi_moderates += 1;
}
if (Q.secularised_education == 1) {
    Q.ppi_moderates += 4;
}
if (Q.pope === "Del Val") {
    Q.ppi_right += 1;
}
if (Q.abortion_rights > 0) {
    Q.ppi_right += 2;
}
if (Q.radicalisation > 7) {
    Q.ppi_right += 1;
